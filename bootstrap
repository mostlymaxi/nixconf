#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTALLER="nixos-installer.local"

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

usage() {
  cat <<EOF
Usage:
  ./bootstrap build-usb [system]           build the installer image and flash it
  ./bootstrap init   <hostname> [target]   scaffold hosts/<hostname>/ from a booted installer
  ./bootstrap deploy <hostname> [target [nixos-anywhere args...]]
                                           wipe the target and install <hostname> on it
  ./bootstrap switch <hostname> [target]   apply config changes to a running host
  ./bootstrap rekey                        re-encrypt secrets for the keys in secret/hosts

system defaults to x86_64-linux
target defaults to $INSTALLER (<hostname>.local for switch)
EOF
  exit 1
}

confirm() {
  read -rp "$1 [y/N] " -n 1
  echo
  [[ $REPLY == [Yy] ]] || exit 1
}

build-usb() {
  local out image device

  out=$(nix build --no-link --print-out-paths "$ROOT#packages.${1:-x86_64-linux}.installer")
  image=$(find "$out" -type f \( -name '*.iso' -o -name '*.img.zst' \))
  echo "Built $image"

  lsblk -dnpo NAME,SIZE,MODEL,RM | grep '1$' || echo "no removable devices found"
  read -rp "Flash to device (blank to skip): " device
  [[ -n $device ]] || return 0
  confirm "This will ERASE ALL DATA on $device. Continue?"

  sudo umount "$device"* 2>/dev/null || true
  case $image in
    *.zst) zstd -dc "$image" ;;
    *) cat "$image" ;;
  esac | sudo dd of="$device" bs=4M status=progress conv=fsync
}

init() {
  local host=$1 target=${2:-$INSTALLER} dir="$ROOT/hosts/$1"
  local lsblk disks disk hw system release
  # installer host keys change on every boot; one shared connection means one YubiKey touch
  local ssh=(ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
    -o ControlMaster=auto -o ControlPersist=60 -o "ControlPath=$TMP/ssh" "root@$target")

  [[ ! -e $dir ]] || { echo "error: hosts/$host already exists" >&2; exit 1; }

  lsblk=$("${ssh[@]}" lsblk -dnpo NAME,SIZE,TRAN,MODEL -e 7,11)
  mapfile -t disks <<<"$lsblk"
  PS3="Install to: "
  select disk in "${disks[@]}"; do [[ -z $disk ]] || break; done
  [[ -n ${disk:-} ]] || exit 1

  hw=$("${ssh[@]}" nixos-generate-config --show-hardware-config --no-filesystems)
  system="$("${ssh[@]}" uname -m)-linux"
  release=$(nix eval --raw --inputs-from "$ROOT" nixpkgs#lib.trivial.release)

  mkdir "$dir"
  printf '%s\n' "$hw" >"$dir/hardware-configuration.nix"

  cat >"$dir/disko.nix" <<EOF
{
  disko.devices.disk.main = {
    type = "disk";
    device = "${disk%% *}";
    content = {
      type = "gpt";
      partitions = {
        ESP = {
          size = "512M";
          type = "EF00";
          content = {
            type = "filesystem";
            format = "vfat";
            mountpoint = "/boot";
            mountOptions = [
              "fmask=0077"
              "dmask=0077"
            ];
          };
        };
        root = {
          size = "100%";
          content = {
            type = "filesystem";
            format = "ext4";
            mountpoint = "/";
          };
        };
      };
    };
  };
}
EOF

  cat >"$dir/default.nix" <<EOF
{ ... }:
{
  imports = [
    ./hardware-configuration.nix
    ./disko.nix
    ../../modules/system
  ];

  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;
  boot.kexec.enable = true;

  system.stateVersion = "$release";
}
EOF

  cat >"$dir/home.nix" <<'EOF'
{ ... }:
{
  shell.fish.enable = true;
  shell.default = "fish";

  programs.core.enable = true;
}
EOF

  # flakes only see files git knows about
  git -C "$ROOT" add --intent-to-add "hosts/$host"

  cat <<EOF

Created hosts/$host/. Review it, then add it to nixosConfigurations in flake.nix:

  $host = mkNixos {
    hostname = "$host";
    system = "$system";
  };

and install with: ./bootstrap deploy $host $target
EOF
}

deploy() {
  local host=$1 target=${2:-$INSTALLER} extra="$TMP/extra"

  confirm "This will ERASE ALL DATA on $target and install $host. Continue?"

  # the host decrypts its secrets with this key, so it has to exist before first boot
  install -d -m 755 "$extra/etc/ssh"
  ssh-keygen -q -t ed25519 -N "" -C "root@$host" -f "$extra/etc/ssh/ssh_host_ed25519_key"
  cut -d' ' -f1,2 "$extra/etc/ssh/ssh_host_ed25519_key.pub" >"$ROOT/secret/hosts/$host.pub"
  git -C "$ROOT" add --intent-to-add "secret/hosts/$host.pub"
  rekey

  # Pis can't kexec: append --phases disko,install and power cycle by hand
  nix run github:nix-community/nixos-anywhere -- \
    --flake "$ROOT#$host" --target-host "root@$target" --build-on local \
    --extra-files "$extra" "${@:3}"

  echo "Commit secret/ so $host keeps access to its secrets."
}

switch() {
  nixos-rebuild switch --flake "$ROOT#$1" --target-host "maxi@${2:-$1.local}" --sudo
}

rekey() {
  local secrets="$ROOT/secret" age name
  age="$(nix build --no-link --print-out-paths nixpkgs#age)/bin/age"

  echo "Re-encrypting secrets with this machine's host key..."
  for name in $(nix eval --raw --file "$secrets/secrets.nix" --apply 's: toString (builtins.attrNames s)'); do
    nix eval --raw --file "$secrets/secrets.nix" \
      --apply "s: builtins.concatStringsSep \"\n\" s.\"$name\".publicKeys" >"$TMP/recipients"
    sudo "$age" -d -i /etc/ssh/ssh_host_ed25519_key "$secrets/$name" |
      "$age" -R "$TMP/recipients" -o "$TMP/$name"
    mv "$TMP/$name" "$secrets/$name"
    echo "  $name: $(grep -c . "$TMP/recipients") hosts"
  done
}

case "${1:-}" in
  build-usb | rekey) "$@" ;;
  init | deploy | switch) [[ $# -ge 2 ]] || usage; "$@" ;;
  *) usage ;;
esac
